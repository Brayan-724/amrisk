// SAFE VERSION
fn memcopy(src: word, dst: word, size: half) {
  let end = src + dst;

  while (end - src > 4) {
    *w dst = *w src;

    src = src + 4;
    dst = dst + 4;
  }

  while (src != end) {
    *b dst = *b src;

    src = src + 1;
    dst = dst + 1;
  }

  dst
}

#[entry]
fn main() {
  let a = 1;

